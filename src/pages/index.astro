---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePage from "../components/HomePage.astro";
import { homePages } from "../content/site";

const page = homePages.en;
---

<BaseLayout
  locale={page.locale}
  title={page.title}
  description={page.description}
  canonicalPath={page.path}
  alternatePath="/nl/"
  skipLabel={page.labels.skip}
>
  <HomePage page={page} />
</BaseLayout>
