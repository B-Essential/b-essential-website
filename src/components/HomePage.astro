---
import Wordmark from "./Wordmark.astro";
import CaseCarousel from "./CaseCarousel.astro";
import { getCaseStudies } from "../content/cases";
import type { SiteContent } from "../content/site";

type Props = {
  page: SiteContent;
};

const { page } = Astro.props;
const caseStudies = getCaseStudies(page.locale);
---

<header aria-label={page.labels.header}>
  <Wordmark href="#top" ariaLabel={page.labels.home} />
  <nav aria-label={page.labels.primaryNav}>
    {page.nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <div class="header-tools">
    <span class="navnote">{page.navNote}</span>
    <div role="group" class="languages" aria-label={page.labels.language}>
      <a href="/" hreflang="en" lang="en" aria-label="English" aria-current={page.locale === "en" ? "page" : undefined}>EN</a>
      <a href="/nl/" hreflang="nl" lang="nl" aria-label="Nederlands" aria-current={page.locale === "nl" ? "page" : undefined}>NL</a>
    </div>
  </div>
</header>

<main id="main" tabindex="-1">
  <section class="hero" id="top" aria-labelledby="hero-heading">
    <div class="hero-number" aria-hidden="true">B.</div>
    <div class="hero-top">
      <span class="eyebrow practice-credit">
        <span>{page.hero.eyebrow}</span>
        <span class="practice-name">{page.hero.name}</span>
      </span>
      <span class="eyebrow">{page.hero.role}</span>
    </div>
    <div class="hero-grid">
      <div>
        <h1 id="hero-heading" set:html={page.hero.heading} />
        <div class="hero-ctas">
          <a href="#contact" class="btn btn-light">{page.hero.primaryCta}</a>
          <a href="#work" class="btn btn-outline">{page.hero.secondaryCta}</a>
        </div>
      </div>
      <p class="hero-description">{page.hero.description}</p>
    </div>
    <div class="hero-bottom">
      <span>{page.hero.discipline}</span>
      <span>{page.hero.availability}</span>
    </div>
  </section>

  <section class="expertise section-pad" id="expertise" aria-labelledby="expertise-heading">
    <span class="section-index">{page.expertise.label}</span>
    <div class="section-lede">
      <h2 id="expertise-heading" set:html={page.expertise.heading} />
      <p>{page.expertise.intro}</p>
    </div>
    <div class="capabilities">
      {page.expertise.items.map((item) => (
        <article class="cap">
          <small>{item.label}</small>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="work section-pad" id="work" aria-labelledby="work-heading">
    <span class="section-index">{page.work.label}</span>
    <div class="work-header">
      <h2 id="work-heading" set:html={page.work.heading} />
      <p>{page.work.intro}</p>
    </div>
    <div class="case-grid">
      {caseStudies.map((caseStudy) => (
        <article class="case">
          <CaseCarousel caseStudy={caseStudy} />
          <div class="case-body">
            <small>{caseStudy.role}</small>
            <h3>{caseStudy.title}</h3>
            <p>{caseStudy.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="ways section-pad" id="working" aria-labelledby="ways-heading">
    <span class="section-index">{page.ways.label}</span>
    <div class="ways-top">
      <h2 id="ways-heading" set:html={page.ways.heading} />
      <p>{page.ways.intro}</p>
    </div>
    <div class="engagements">
      {page.ways.items.map((item, index) => (
        <article class:list={["engagement", index === 0 && "fulltime"]}>
          <b aria-hidden="true">{String(index + 1).padStart(2, "0")}</b>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="ventures section-pad" id="ventures" aria-labelledby="ventures-heading">
    <span class="section-index">{page.ventures.label}</span>
    <div class="venture-intro">
      <h2 id="ventures-heading" set:html={page.ventures.heading} />
      <p>{page.ventures.intro}</p>
    </div>
    <div class="venture-grid">
      {page.ventures.items.map((venture, index) => (
        <div class="venture">
          <span class="count">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3>{venture.title}</h3>
            <span class="venture-tag">{venture.subtitle}</span>
          </div>
          <p>{venture.body}</p>
          <a
            href={venture.href}
            target="_blank"
            rel="noopener"
            aria-label={venture.ariaLabel}
          >{venture.linkLabel}</a>
        </div>
      ))}
    </div>
  </section>

  <section class="about section-pad" id="about" aria-labelledby="about-heading">
    <figure class="about-portrait">
      <img {...page.about.portrait} loading="lazy" decoding="async" />
    </figure>
    <div class="about-copy">
      <span class="section-index">{page.about.label}</span>
      <h2 id="about-heading" set:html={page.about.heading} />
      {page.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section
    class="contact"
    id="contact"
    aria-labelledby="contact-heading"
    data-email-help={page.contact.noEmailMessage}
    data-copy-success={page.contact.copiedMessage}
    data-copy-manual={page.contact.manualCopyMessage}
  >
    <span class="section-index">{page.contact.label}</span>
    <h2 id="contact-heading" set:html={page.contact.heading} />
    <p>{page.contact.body}</p>
    <a href={page.contact.href} class="btn btn-dark">{page.contact.cta}</a>
    <div class="contact-email-row">
      <a href={page.contact.addressHref} class="contact-address">{page.contact.address}</a>
      <button type="button" hidden class="copy-address">{page.contact.copyLabel}</button>
    </div>
    <p role="status" class="contact-feedback" aria-live="polite" aria-atomic="true" />
  </section>
</main>

<footer>
  <Wordmark href="#top" ariaLabel={page.labels.home} />
  <span>{page.footer}</span>
</footer>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>(".languages a")) {
    const path = link.getAttribute("href");
    if (!path) continue;
    // Keep the visitor at the same section when switching language.
    const updateHref = () => link.setAttribute("href", path + window.location.hash);
    updateHref();
    window.addEventListener("hashchange", updateHref);
  }

  const contact = document.querySelector<HTMLElement>("#contact");
  const address = contact?.querySelector<HTMLAnchorElement>(".contact-address");
  const copyButton = contact?.querySelector<HTMLButtonElement>(".copy-address");
  const feedback = contact?.querySelector<HTMLElement>(".contact-feedback");

  if (contact && address && copyButton && feedback) {
    contact.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest('a[href^="mailto:"]')) {
        feedback.textContent = contact.dataset.emailHelp ?? "";
      }
    });

    copyButton.hidden = false;
    copyButton.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(address.textContent?.trim() ?? "");
        feedback.textContent = contact.dataset.copySuccess ?? "";
      } catch {
        const selection = window.getSelection();
        if (selection) {
          const range = document.createRange();
          range.selectNodeContents(address);
          selection.removeAllRanges();
          selection.addRange(range);
        }
        feedback.textContent = contact.dataset.copyManual ?? "";
      }
    });
  }
</script>
