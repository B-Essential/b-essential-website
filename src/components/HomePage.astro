---
import Wordmark from "./Wordmark.astro";
import { languages, type SiteContent } from "../content/site";

type Props = {
  page: SiteContent;
};

const { page } = Astro.props;
const year = new Date().getFullYear();
const homeHref = page.locale === "nl" ? "/" : "/en/";
const labels =
  page.locale === "nl"
    ? {
        home: "B.essential startpagina",
        header: "Sitekop",
        primaryNav: "Hoofdnavigatie",
        language: "Taalkeuze",
        applications: "Toepassingen"
      }
    : {
        home: "B.essential home",
        header: "Site header",
        primaryNav: "Primary navigation",
        language: "Language selector",
        applications: "Applications"
      };
---

<header class="site-header" aria-label={labels.header}>
  <div class="site-shell header-grid">
    <Wordmark href={homeHref} ariaLabel={labels.home} />
    <nav class="site-nav" aria-label={labels.primaryNav}>
      <a href="#work">{page.nav.work}</a>
      <a href="#approach">{page.nav.approach}</a>
      <a href="#about">{page.nav.about}</a>
      <div class="language-switcher" aria-label={labels.language}>
        <a
          class:list={[page.locale === "nl" && "is-active"]}
          href="/"
          hreflang="nl"
          aria-current={page.locale === "nl" ? "page" : undefined}
        >
          {languages.nl}
        </a>
        <span aria-hidden="true">/</span>
        <a
          class:list={[page.locale === "en" && "is-active"]}
          href="/en/"
          hreflang="en"
          aria-current={page.locale === "en" ? "page" : undefined}
        >
          {languages.en}
        </a>
      </div>
    </nav>
  </div>
</header>

<main id="main">
  <section class="hero site-shell" aria-labelledby="hero-heading">
    <div class="hero__meta">{page.hero.line}</div>
    <div class="hero__body">
      <h1 id="hero-heading">{page.hero.headline}</h1>
      <p>{page.hero.copy}</p>
    </div>
  </section>

  <section id="work" class="section section--work" aria-labelledby="work-heading">
    <div class="site-shell section-grid">
      <div class="section-kicker">01</div>
      <div class="section-intro">
        <h2 id="work-heading">{page.work.heading}</h2>
        <p>{page.work.intro}</p>
      </div>
      <div class="work-list" aria-label={page.work.heading}>
        {
          page.work.items.map((item) => (
            <article class="work-item">
              <p class="item-number">{item.number}</p>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="approach"
    class="section section--compact"
    aria-labelledby="approach-heading"
  >
    <div class="site-shell section-grid">
      <div class="section-kicker">02</div>
      <div class="section-intro">
        <h2 id="approach-heading">{page.approach.heading}</h2>
        <p>{page.approach.intro}</p>
      </div>
      <div class="process">
        <p class="process__line">{page.approach.process}</p>
        <ol class="process__steps">
          {
            page.approach.items.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section
    id="initiatives"
    class="section section--initiatives"
    aria-labelledby="initiatives-heading"
  >
    <div class="site-shell section-grid">
      <div class="section-kicker">03</div>
      <div class="section-intro">
        <h2 id="initiatives-heading">{page.initiatives.heading}</h2>
        <p>{page.initiatives.intro}</p>
      </div>
      <div class="initiative-list">
        {
          page.initiatives.items.map((item) => (
            <article class="initiative-item">
              <div class="initiative-item__number">{item.number}</div>
              <div class="initiative-item__content">
                <p class="eyebrow">{item.metadata}</p>
                <h3>{item.title}</h3>
                <p class="subtitle">{item.subtitle}</p>
                <p>{item.body}</p>
                {item.applications && (
                  <ul class="tag-list" aria-label={labels.applications}>
                    {item.applications.map((application) => (
                      <li>{application}</li>
                    ))}
                  </ul>
                )}
                {item.link && (
                  <a class="text-link" href={item.link.href} aria-label={item.link.ariaLabel}>
                    {item.link.label}
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--ventures" aria-labelledby="ventures-heading">
    <div class="site-shell section-grid">
      <div class="section-kicker">04</div>
      <div class="section-intro">
        <h2 id="ventures-heading">{page.ventures.heading}</h2>
        <p>{page.ventures.intro}</p>
      </div>
      <div class="venture-list">
        {
          page.ventures.items.map((item) => (
            <article class="venture-item">
              <h3>{item.title}</h3>
              <p class="subtitle">{item.subtitle}</p>
              <p>{item.body}</p>
              {item.link && (
                <a class="text-link" href={item.link.href} aria-label={item.link.ariaLabel}>
                  {item.link.label}
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="about" class="section section--about" aria-labelledby="about-heading">
    <div class="site-shell section-grid section-grid--about">
      <div class="section-kicker">05</div>
      <div class="about-callout">
        <h2 id="about-heading">{page.about.heading}</h2>
        <p>{page.about.callout}</p>
      </div>
      <div class="about-copy">
        {page.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="contact site-shell" aria-labelledby="contact-heading">
    <div class="contact__inner">
      <h2 id="contact-heading">{page.contact.heading}</h2>
      <p>{page.contact.copy}</p>
      <a class="contact-link" href={page.contact.href} aria-label={page.contact.ariaLabel}>
        {page.contact.link}
      </a>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="site-shell footer-grid">
    <div class="footer-brand">
      <Wordmark href={homeHref} ariaLabel={labels.home} />
      <p>KVK 95428054</p>
    </div>
    <p>{year}</p>
    <div class="language-switcher" aria-label={labels.language}>
      <a
        class:list={[page.locale === "nl" && "is-active"]}
        href="/"
        hreflang="nl"
        aria-current={page.locale === "nl" ? "page" : undefined}
      >
        {languages.nl}
      </a>
      <span aria-hidden="true">/</span>
      <a
        class:list={[page.locale === "en" && "is-active"]}
        href="/en/"
        hreflang="en"
        aria-current={page.locale === "en" ? "page" : undefined}
      >
        {languages.en}
      </a>
    </div>
  </div>
</footer>
